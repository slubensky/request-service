{
  "name": "request-service",
  "version": "0.1.0",
  "private": true,
  "description": "QR bathroom cleaning service request app: no-framework, no-bundler Lean SSR on Node.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  }
}
