# Copy to .env and fill in for local development.
# Real values (Secrets Manager) are injected at runtime in AWS -- see infra/.
# Nothing here is loaded automatically by the app; load it into your shell
# (e.g. `export $(grep -v '^#' .env | xargs)`, or a tool like direnv/dotenvx)
# before running npm run dev / npm start.

# Required -- local Postgres connection (see README "Local development").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/request_service

# Required -- signs session cookies and CSRF tokens (HMAC-SHA256). Any long
# random string works for local dev; never reuse a real deployment's value.
SESSION_SECRET=change-me-to-a-long-random-local-only-string

# Optional -- HTTP port (default 3000).
# PORT=3000

# Optional -- base URL encoded into issued QR codes (default: the request's
# own Host header). Set this if you're scanning QR codes from a phone on your
# LAN, e.g. http://192.168.1.23:3000
# PUBLIC_BASE_URL=http://localhost:3000

# Optional -- turns on the DEMO_MODE invite-accept loop (SDD §6.3), which lets
# you walk invite -> accept -> activation in a browser with no Cognito/SMS.
# Unset (or any value other than 1/true/on/yes) in production.
DEMO_MODE=1

# Optional -- Amazon Cognito (managed passwordless auth, SDD §6). Leave unset
# for local dev: auth routes fail closed (503) rather than run half-configured,
# and DEMO_MODE plus `npm run dev:login` cover the full local walkthrough
# without a real Cognito user pool. Fill these in only if you've deployed one
# (infra/modules/cognito) and want to exercise real SMS OTP / passkey sign-in.
# COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
# COGNITO_LOGOUT_REDIRECT_URI=http://localhost:3000/
